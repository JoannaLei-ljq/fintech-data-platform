# Local-only development credentials. Copy to .env and adjust if needed.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=fintech
POSTGRES_PASSWORD=change_me_local_only
OLTP_DB=fintech_oltp
ANALYTICS_DB=fintech_analytics

# Airflow (local only). Generate fresh values; never reuse these placeholders.
AIRFLOW_UID=501
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_FERNET_KEY=generate_with_python_base64_urlsafe_32_bytes
AIRFLOW_JWT_SECRET=change_me
AIRFLOW_API_SECRET_KEY=change_me

# V2 sync login (least privilege). scripts/v2/provision_sync_login.sh generates the password if absent.
V2_SYNC_USER=v2_sync_login
V2_SYNC_PASSWORD=change-me-to-a-random-value
